# COSIGNA MCP connector — environment (copy to your Claude Desktop config env block).
# NEVER commit a real token. This file ships with placeholders only.

# Required: an existing COSIGNA bearer session (30-day TTL). Mint it per README.md:
#   POST /auth/request-link  ->  GET /auth/verify-link -H 'Accept: application/json'
COSIGNA_SESSION_TOKEN=REPLACE_WITH_YOUR_SESSION_TOKEN

# Base URL of the COSIGNA service (default https://cosigna.eu).
COSIGNA_MCP_BASE_URL=https://cosigna.eu

# Comma-separated founder-domain allowlist. The connector REFUSES to email participants
# outside this list. Empty = it will not email anyone (returns links for hand-delivery).
COSIGNA_MCP_ALLOWED_DOMAINS=your-founder-domain.example

# Abuse-gate overrides (optional).
# COSIGNA_MCP_MAX_PARTICIPANTS=4
# COSIGNA_MCP_MAX_OPENS=3

# Hardening (optional). Audit log path (append-only, 0600, secret-redacted) + per-tool rate
# limits ("<count>/<window_seconds>"; "0/0" disables). See README "Production hardening".
# COSIGNA_MCP_AUDIT_LOG=~/.cosigna_mcp_audit.jsonl
# COSIGNA_MCP_RATE_OPEN_CEREMONY=5/300

# So `import cosigna.verify` (the on-camera re-verification) resolves to the vendored core.
PYTHONPATH=_verifycore
