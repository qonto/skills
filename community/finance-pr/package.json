{
  "name": "finance-pr-qonto",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Finance PR for Qonto MCP — review before money moves.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pr": "tsx src/node/cli.ts",
    "scan:secrets": "node scripts/scan-secrets.mjs"
  },
  "dependencies": {
    "js-sha256": "0.11.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "tsx": "4.23.0",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "2.1.9"
  }
}
